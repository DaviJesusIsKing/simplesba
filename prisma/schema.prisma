generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Establishment {
  id              String   @id @default(cuid())
  name            String
  description     String
  address         String
  phone           String
  whatsapp        String
  instagram       String   @default("")
  openDays        String   @default("1,2,3,4,5,6")
  openTime        String   @default("09:00")
  closeTime       String   @default("19:00")
  primaryColor    String   @default("#d4a017")
  bgColor         String   @default("#0f0f0f")
  cardColor       String   @default("#1a1a1a")
  /// Chave PIX (e-mail, telefone, CPF/CNPJ ou aleatória)
  pixKey          String   @default("")
  /// Nome que aparece no pagamento
  pixName         String   @default("")
  /// Texto livre: instruções pro cliente
  pixInstructions String   @default("")
  /// full = valor inteiro | half = 50% sinal | both = admin aceita os dois modos no valor
  pixChargeMode   String   @default("full")
  /// both = cliente escolhe | pix_only = só antecipado | local_only = só na hora
  paymentPolicy   String   @default("both")
  /// JSON: {"1":{"open":"08:00","close":"12:00"}} por dia 0=Dom..6=Sáb
  hoursByDay      String   @default("{}")
  updatedAt       DateTime @updatedAt
  services        Service[]
  products        Product[]
  appointments    Appointment[]
}

model Service {
  id              String        @id @default(cuid())
  name            String
  description     String
  price           Float
  duration        Int
  active          Boolean       @default(true)
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  appointments    Appointment[]
}

model Product {
  id              String        @id @default(cuid())
  name            String
  description     String
  price           Float
  stock           Int           @default(0)
  active          Boolean       @default(true)
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
}

model Appointment {
  id              String    @id @default(cuid())
  clientName      String
  clientPhone     String
  date            String
  time            String
  status          String    @default("pending")
  /// local = paga no salão | pix = paga antes
  paymentMethod   String    @default("local")
  /// unpaid | awaiting_receipt | paid | rejected
  paymentStatus   String    @default("unpaid")
  amountDue       Float     @default(0)
  receiptData     String?
  receiptNote     String?
  rejectReason    String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id])
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  @@index([establishmentId, date])
  @@index([status, expiresAt])
  @@index([clientPhone])
}
